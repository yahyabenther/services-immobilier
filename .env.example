# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored and bundled as an asset: `flutter build` fails without it.
# Ask a teammate for the real values, or read them in the Firebase / Cloudinary consoles.

# ---- Firebase (public client identifiers: Firebase Console > Project settings) ----
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com

FIREBASE_ANDROID_API_KEY=YOUR_ANDROID_API_KEY
FIREBASE_ANDROID_APP_ID=YOUR_ANDROID_APP_ID

FIREBASE_IOS_API_KEY=YOUR_IOS_API_KEY
FIREBASE_IOS_APP_ID=YOUR_IOS_APP_ID
FIREBASE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID
FIREBASE_IOS_BUNDLE_ID=YOUR_IOS_BUNDLE_ID

FIREBASE_WEB_API_KEY=YOUR_WEB_API_KEY
FIREBASE_WEB_APP_ID=YOUR_WEB_APP_ID
FIREBASE_WEB_MEASUREMENT_ID=YOUR_WEB_MEASUREMENT_ID

FIREBASE_WINDOWS_APP_ID=YOUR_WINDOWS_APP_ID
FIREBASE_WINDOWS_MEASUREMENT_ID=YOUR_WINDOWS_MEASUREMENT_ID

# ---- Cloudinary (UNSIGNED presets only: never put the API secret here) ----
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_UPLOAD_PRESET=YOUR_UPLOAD_PRESET
CLOUDINARY_VERIFICATION_PRESET=YOUR_VERIFICATION_PRESET

# Optional: signed-link endpoint for private verification documents (empty = not used).
VERIFICATION_DOCUMENT_ENDPOINT=

# ---- Map (optional) ----
# Empty = public OpenStreetMap tiles (demo only). Use a tile provider before launch.
MAP_TILE_URL=
# Your Android applicationId (OpenStreetMap usage policy).
MAP_USER_AGENT_PACKAGE=tn.darna.immobilier
