rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Module 01: users ---------------------------------------------------
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['id', 'name', 'email', 'phone', 'role', 'status', 'verified', 'createdAt'])
        && request.resource.data.id == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.verified == false
        && request.resource.data.email == request.auth.token.email;

      // Module 02: notificationPreferences added (Notifications page saves it).
      allow update: if (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'photoUrl', 'preferredCity', 'notificationPreferences']))
        || isAdmin();

      allow delete: if false;
    }

    // ---- Module 03: public discovery of properties ---------------------------
    match /properties/{propertyId} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      // ---- Module 09: My Listings (owner actions) -----------------------------
      // Same transitions as lib/features/listings/domain/listing_actions.dart.
      function isOwner() {
        return signedIn() && resource.data.ownerId == request.auth.uid;
      }
      function ownerTransition(from, to) {
        return (from == 'draft' && to == 'pending_review')
          || (from == 'published' && to == 'removed')
          || (from in ['rejected', 'removed'] && to == 'draft');
      }

      // Owner may ONLY change status (+ updatedAt), through an allowed transition.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ownerTransition(resource.data.status, request.resource.data.status);

      // Owner may delete only listings that are not live or under review.
      allow delete: if isOwner()
        && resource.data.status in ['draft', 'rejected', 'removed'];

      // Admin keeps full control (moderation).
      allow create, update, delete: if isAdmin();
    }
  }
}
